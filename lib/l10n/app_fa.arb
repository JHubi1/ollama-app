  "settingsTitleAccessibility": "دسترس‌پذیری",
  "@settingsTitleAccessibility": {
    "description": "Title of the accessibility settings section",
    "context": "Visible in the settings view"
  },
  "settingsDescriptionAccessibility": "بیانیه دسترس‌پذیری، نتایج آزمون‌ها و نحوه گزارش یک مشکل.",
  "@settingsDescriptionAccessibility": {
    "description": "Description of the accessibility settings section",
