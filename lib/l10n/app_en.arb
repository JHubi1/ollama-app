    "accessibilityStatementTitle": "Accessibility statement",
    "@accessibilityStatementTitle": {
        "description": "Title of the accessibility statement section",
        "context": "Visible on the accessibility page"
    },
    "accessibilityCommitmentIntro": "Ollama must be usable by people of all abilities, in every language we ship. Voice control, screen readers, keyboard navigation and high-contrast rendering are first-class ways of using this app — not afterthoughts.",
    "@accessibilityCommitmentIntro": {
        "description": "Opening commitment text of the accessibility statement",
        "context": "Visible on the accessibility page"
    },
    "accessibilityCommitmentDetails": "In practice this means: every interactive control has a name that screen readers announce (including the voice-mode state), buttons keep a minimum touch target of 48dp, keyboard focus follows the visual order of the interface, status messages are announced while they change, and the interface stays usable at large text scales and in both light and dark themes.",
    "@accessibilityCommitmentDetails": {
        "description": "Detailed commitment text of the accessibility statement",
        "context": "Visible on the accessibility page"
    },
    "accessibilityConformanceTitle": "Conformance status",
    "@accessibilityConformanceTitle": {
        "description": "Title of the conformance status section",
        "context": "Visible on the accessibility page"
    },
    "accessibilityConformanceStatus": "This app is designed to conform with the Web Content Accessibility Guidelines (WCAG) 2.2 Level AA. The conformance has not been independently certified by a third party; it is based on our own automated testing. Where feasible we go beyond AA and apply WCAG AAA measures, which are listed below.",
    "@accessibilityConformanceStatus": {
        "description": "Conformance status text of the accessibility statement",
        "context": "Visible on the accessibility page"
    },
    "accessibilityAaaMeasuresTitle": "Exceeding AA (AAA measures)",
    "@accessibilityAaaMeasuresTitle": {
        "description": "Title of the AAA measures section",
        "context": "Visible on the accessibility page"
    },
    "accessibilityAaaMeasures": "The main text uses 21:1 contrast in both themes (AAA requires 7:1), muted secondary text uses 10:1 or better, status colours for success and warnings meet AAA contrast in both themes, and error text in the dark theme meets AAA contrast. AAA additionally requires measures that are not practical in a chat application of this size (for example 7:1 contrast on absolutely all text and reading-level limits), so we target AA as the guarantee and treat these AAA measures as enhancements.",
    "@accessibilityAaaMeasures": {
        "description": "Text describing the applied AAA measures",
        "context": "Visible on the accessibility page"
    },
    "accessibilityAodaTitle": "Accessibility for Ontarians with Disabilities Act (AODA)",
    "@accessibilityAodaTitle": {
        "description": "Title of the AODA section",
        "context": "Visible on the accessibility page"
    },
    "accessibilityAodaText": "Ontario's Accessibility for Ontarians with Disabilities Act (AODA) requires digital products to meet WCAG 2.0/2.1 Level AA. The WCAG 2.2 Level AA target of this app meets and exceeds that baseline. Feedback on accessibility is welcomed through the contact form on this page, in line with AODA's requirement to make feedback channels accessible.",
    "@accessibilityAodaText": {
        "description": "Text about AODA compliance",
        "context": "Visible on the accessibility page"
    },
    "accessibilityStandardsEuropeTitle": "European standards (EN 301 549)",
    "@accessibilityStandardsEuropeTitle": {
        "description": "Title of the European standards section",
        "context": "Visible on the accessibility page"
    },
    "accessibilityStandardsEuropeText": "In the European Union, harmonized standard EN 301 549 defines the ICT accessibility requirements of the European Accessibility Act, which references WCAG 2.1 Level AA. The WCAG 2.2 Level AA target of this app covers those requirements, supporting the European accessibility obligations that apply from 28 June 2025.",
    "@accessibilityStandardsEuropeText": {
        "description": "Text about the European standards (EN 301 549 / EAA)",
        "context": "Visible on the accessibility page"
    },
    "accessibilityStandardsUsTitle": "United States standards (ADA / Section 508)",
    "@accessibilityStandardsUsTitle": {
        "description": "Title of the United States standards section",
        "context": "Visible on the accessibility page"
    },
    "accessibilityStandardsUsText": "In the United States, the Americans with Disabilities Act (ADA) is the general non-discrimination baseline, and Section 508 of the Rehabilitation Act requires WCAG 2.0 Level AA for federal technology (Section 504 extends similar obligations to funded programs). The WCAG 2.2 Level AA target of this app meets and exceeds those baselines.",
    "@accessibilityStandardsUsText": {
        "description": "Text about the US standards (ADA / Section 508 / Section 504)",
        "context": "Visible on the accessibility page"
    },
    "accessibilityKnownIssuesTitle": "Known limitations",
    "@accessibilityKnownIssuesTitle": {
        "description": "Title of the known limitations section",
        "context": "Visible on the accessibility page"
    },
    "accessibilityKnownIssues": "The desktop window title-bar buttons (minimize, maximize, close) are provided by the operating system integration and are not reachable by the app's screen-reader tree. The chat library renders a small amount of its own interface text, which may not yet be available in all languages. In voice mode, the response text is faded near the edge of the screen and very long chat lines can be truncated with an ellipsis when the system text size is increased significantly.",
    "@accessibilityKnownIssues": {
        "description": "Text describing the known accessibility limitations",
        "context": "Visible on the accessibility page"
